(footprint "ChiliDisplayModule_Host"
	(version 20260206)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "Host footprint for the chilichip display module (28 x 22 mm, 8 castellated pads on the left and right edges). The module lies flat on the main board (all its parts are on its top side) and is hand soldered. Keep parts and exposed copper out from under the module; tented vias and tracks are fine. Origin = module top-left corner.")
	(tags "chilichip display module castellated flat")
	(attr smd)
	(property "Reference" "DISP" (at 14 -2.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "ChiliDisplayModule" (at 14 23.5 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(fp_line (start 0 0) (end 28 0) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 28 0) (end 28 22) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 28 22) (end 0 22) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 0 22) (end 0 0) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start -1.8 -0.5) (end 29.8 -0.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 29.8 -0.5) (end 29.8 22.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 29.8 22.5) (end -1.8 22.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start -1.8 22.5) (end -1.8 -0.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 0 -0.12) (end 28 -0.12) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start 0 22.12) (end 28 22.12) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -0.8 5.19) (end -0.8 16.81) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start 28.8 5.19) (end 28.8 16.81) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(pad "1" smd roundrect (at -0.3 14.81) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "2" smd roundrect (at -0.3 12.27) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "3" smd roundrect (at -0.3 9.73) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "4" smd roundrect (at -0.3 7.19) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "5" smd roundrect (at 28.3 7.19) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "6" smd roundrect (at 28.3 9.73) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "7" smd roundrect (at 28.3 12.27) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "8" smd roundrect (at 28.3 14.81) (size 2.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(model "${KIPRJMOD}/3d-models/chili-display-module-hardware.step"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
